# =========================
# SENTRY
# =========================
SENTRY_DSN=your sentry DSN


# =========================
# POSTGRESQL
# =========================
POSTGRES_DB=your database name
POSTGRES_USER=your database user
POSTGRES_PASSWORD=your database password
POSTGRES_HOST=your database host
POSTGRES_PORT=your database port


# =========================
# BACKEND
# =========================
SECRET_KEY=your django secret key
DEBUG=your debug mode
ALLOWED_HOSTS=your allowed hosts
BACKEND_PORT=your backend port


# =========================
# REDIS
# =========================
REDIS_HOST=your redis host
REDIS_PORT=your redis port


# =========================
# SMTP4DEV
# =========================
EMAIL_HOST=your email host
EMAIL_PORT=your email port
EMAIL_USE_TLS=your email TLS setting
EMAIL_HOST_USER=your email username
EMAIL_HOST_PASSWORD=your email password
DEFAULT_FROM_EMAIL=your default email address

SMTP4DEV_WEB_PORT=your smtp4dev web port
SMTP4DEV_SMTP_PORT=your smtp4dev SMTP port
SMTP4DEV_IMAP_PORT=your smtp4dev IMAP port


# =========================
# CELERY
# =========================
CELERY_TIMEZONE=your celery timezone


# =========================
# CORS
# =========================
CORS_ALLOWED_ORIGINS=your allowed frontend origins


# =========================
# N8N
# =========================
N8N_PORT=your n8n port
N8N_BASIC_AUTH_USER=your n8n username
N8N_BASIC_AUTH_PASSWORD=your n8n password


# =========================
# ELASTICSEARCH
# =========================
ELASTICSEARCH_HOST=your elasticsearch host
ELASTICSEARCH_PORT=your elasticsearch port
ELASTICSEARCH_MEMORY=your elasticsearch memory limit


# =========================
# KIBANA
# =========================
KIBANA_PORT=your kibana port


# =========================
# LOGSTASH
# =========================
LOGSTASH_BEATS_PORT=your logstash beats port
LOGSTASH_TCP_PORT=your logstash TCP port
LOGSTASH_MONITORING_PORT=your logstash monitoring port


# =========================
# LOCUST
# =========================
LOCUST_PORT=your locust port